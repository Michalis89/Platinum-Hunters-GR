    "framer-motion": "^12.4.3",
    "lodash.clonedeep": "^4.5.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.6",
    "pg": "^8.13.3",
    "playwright": "^1.50.1",
    "psn-api": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-redux": "^9.2.0",
    "xml2js": "^0.6.2"

{
  "name": "platinum-hunters",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "ci": "npm run lint && npm test && npm run build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --coverage",
    "test:coverage": "npm test -- --coverage --coverageReporters=text-lcov > lcov.info",
